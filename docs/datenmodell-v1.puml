@startuml Datenmodell_V1

title Game-based Learning – Datenmodell Version 1 (Entwurf, nicht implementiert)

hide circle
hide methods
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam backgroundColor #FFFFFF
skinparam entity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
  HeaderBackgroundColor #E2E8F0
}

package "Identität und Katalog" #EEF6FF {
  entity users {
    * id : UUID <<PK>>
    --
    external_subject : VARCHAR <<UQ>>
    username : VARCHAR <<UQ>>
    display_name : VARCHAR
    role : VARCHAR
    current_class_code : VARCHAR?
    active : BOOLEAN
  }

  entity subjects {
    * id : UUID <<PK>>
    --
    name : VARCHAR <<UQ>>
    short_name : VARCHAR?
    active : BOOLEAN
  }
}

package "Spiele und Versionen" #F2FCEB {
  entity game_families {
    * id : UUID <<PK>>
    --
    created_at : TIMESTAMP
  }

  entity games {
    * id : UUID <<PK>>
    --
    family_id : UUID <<FK>>
    copied_from_game_id : UUID? <<FK>>
    creator_user_id : UUID? <<FK>>
    visibility : VARCHAR
    current_version_id : UUID <<FK>>
    deleted_at : TIMESTAMP?
  }

  entity game_versions {
    * id : UUID <<PK>>
    --
    game_id : UUID <<FK>>
    version_number : INTEGER
    title : VARCHAR
    description : TEXT
    game_mode : VARCHAR
    subject_id : UUID <<FK>>
    created_at : TIMESTAMP
    --
    UQ(game_id, version_number)
  }
}

package "Fragen" #FFF8E7 {
  entity questions {
    * id : UUID <<PK>>
    --
    game_id : UUID <<FK>>
    copied_from_question_id : UUID? <<FK>>
    current_version_id : UUID <<FK>>
    deleted_at : TIMESTAMP?
  }

  entity question_versions {
    * id : UUID <<PK>>
    --
    question_id : UUID <<FK>>
    version_number : INTEGER
    type : VARCHAR
    text : TEXT
    created_at : TIMESTAMP
    --
    UQ(question_id, version_number)
  }

  entity game_version_questions {
    * game_version_id : UUID <<PK,FK>>
    * question_version_id : UUID <<PK,FK>>
    --
    position : INTEGER
    UQ(game_version_id, position)
  }

  entity true_false_configs {
    * question_version_id : UUID <<PK,FK>>
    --
    correct_value : BOOLEAN
  }

  entity ordering_items {
    * id : UUID <<PK>>
    --
    question_version_id : UUID <<FK>>
    text : VARCHAR
    correct_position : INTEGER
    --
    UQ(question_version_id, correct_position)
  }

  entity accepted_text_answers {
    * id : UUID <<PK>>
    --
    question_version_id : UUID <<FK>>
    answer : VARCHAR
  }
}

package "Sessions und Ergebnisse" #F5F0FF {
  entity game_sessions {
    * id : UUID <<PK>>
    --
    game_id : UUID <<FK>>
    game_version_id : UUID <<FK>>
    host_user_id : UUID? <<FK>>
    mode : VARCHAR
    started_at : TIMESTAMP
    finished_at : TIMESTAMP
    created_at : TIMESTAMP
  }

  entity teams {
    * id : UUID <<PK>>
    --
    session_id : UUID <<FK>>
    name : VARCHAR
    color : VARCHAR?
    score : INTEGER
    placement : INTEGER?
    --
    UQ(session_id, name)
  }

  entity session_participants {
    * id : UUID <<PK>>
    --
    session_id : UUID <<FK>>
    user_id : UUID <<FK>>
    team_id : UUID? <<FK>>
    score : INTEGER
    placement : INTEGER?
    winner : BOOLEAN
    joined_at : TIMESTAMP
    --
    UQ(session_id, user_id)
  }

  entity player_answers {
    * id : UUID <<PK>>
    --
    participant_id : UUID <<FK>>
    question_version_id : UUID <<FK>>
    answer_data : JSON/TEXT
    correct : BOOLEAN
    score : INTEGER
    response_time_ms : BIGINT?
    answered_at : TIMESTAMP
    --
    UQ(participant_id, question_version_id)
  }
}

package "Qualitätssicherung" #FFF0F3 {
  entity question_reports {
    * id : UUID <<PK>>
    --
    question_id : UUID <<FK>>
    question_version_id : UUID <<FK>>
    reporter_user_id : UUID <<FK>>
    resolved_by_user_id : UUID? <<FK>>
    comment : TEXT
    status : VARCHAR
    resolution_comment : TEXT?
  }
}

users |o--o{ games : erstellt
subjects ||--o{ game_versions : kategorisiert
game_families ||--|{ games : gruppiert
games ||--|{ game_versions : versioniert
games |o--|| game_versions : aktuelle_Version

games ||--o{ questions : enthaelt
questions ||--|{ question_versions : versioniert
questions |o--|| question_versions : aktuelle_Version
game_versions ||--|{ game_version_questions : ordnet
question_versions ||--o{ game_version_questions : verwendet
question_versions ||--o| true_false_configs : Wahr_Falsch
question_versions ||--o{ ordering_items : Reihenfolge
question_versions ||--o{ accepted_text_answers : Freitext

games ||--o{ game_sessions : wird_gespielt
game_versions ||--o{ game_sessions : Snapshot
users |o--o{ game_sessions : hostet
game_sessions ||--o{ teams : bildet
game_sessions ||--|{ session_participants : hat
users ||--o{ session_participants : spielt
teams |o--o{ session_participants : gruppiert
session_participants ||--o{ player_answers : beantwortet
question_versions ||--o{ player_answers : bewertet

questions ||--o{ question_reports : betrifft
question_versions ||--o{ question_reports : gemeldete_Version
users ||--o{ question_reports : meldet
users |o--o{ question_reports : bearbeitet

note right of games
  Neue Spiele: Ersteller Pflicht, Standard PRIVATE.
  Besitzerlose Altspiele: Ersteller optional, PUBLIC.
  Ersteller oder Admin bearbeitet und löscht.
  Private Bibliothek: Ersteller und Admin.
end note

note right of game_versions
  Änderungen erzeugen atomar einen neuen Snapshot.
  Neue Runden verwenden die aktuelle Version.
  Laufende Runden behalten ihren Snapshot flüchtig.
end note

note bottom of game_sessions
  Nur vollständig abgeschlossene Runden dauerhaft speichern.
  Lobby, laufende und abgebrochene Runden bleiben flüchtig.
  Host spielt nicht mit und erhält keinen Fortschritt.
  Singleplayer: host_user_id NULL (Modellannahme).
  Private Host-Runde ohne Mitspieler: noch offen.
  Gespeicherter Ergebnisentwurf hat mind. 1 Teilnehmer.
end note

note bottom of session_participants
  Aktive Schüler, Singleplayer-Lehrkräfte und Admins:
  score ist die Quelle für Fortschritt und Gesamtlevel.
  Alle Teilnehmer erhalten Punkte, Plätze 1 bis 3 deutlich mehr.
  Formel und Bonus bei Gleichstand an Platz 3 sind offen.
  Lehrer-Teilnahme im Multiplayer ist noch offen.
  team_id muss zu einem Team derselben Session gehören.
end note

note right of users
  ADMIN geplant: Backend prüft fest die Schul-Keycloak-
  Benutzernamen it220269, it220240 und it220265.
  Token-Feld technisch noch zu verifizieren.
  Kein eigener Admin-Login oder DB-Vergabeweg.
end note

note right of question_reports
  Melden mit Kommentar; Kopien übernehmen keine Meldung.
  Beim Löschen der Frage wird ihre Meldung gelöscht.
  Wer Meldungsdetails sieht, ist offen.
  Status und Bearbeitungsablauf sind Entwurfsvorschläge.
end note

note right of question_versions
  Historische Antwortversionen sollen erhalten bleiben.
  Frage/Meldung löschen kollidiert mit question_id-FK.
  Entkopplung oder Löschmodell ist noch offen.
  questions.deleted_at ist nur ein technischer Vorschlag.
end note

note bottom of player_answers
  question_version_id muss Teil der von der Session
  verwendeten Spielversion sein.
end note

@enduml
